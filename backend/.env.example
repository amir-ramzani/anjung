# Copy to .env and `set -a; source .env; set +a` (or use direnv). Non-secret settings (LLD 14.6).
ENV=local
AWS_REGION=ap-southeast-1
TABLE_NAME=anjung-main
# DynamoDB Local or moto server
DYNAMODB_ENDPOINT_URL=http://localhost:8000   # docker compose up -d dynamodb
COGNITO_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_IDS=spa-client-id,smoke-client-id
PLATFORM_ORG_ID=01JD8Z3K9Q4M7T2V6X8B5N1C0A
# Comma separated, first key signs, all verify (rotation). At least 32 characters each.
CURSOR_HMAC_KEYS=change-me-change-me-change-me-change-me
LOG_LEVEL=INFO
# Local mock auth (no Cognito): POST /dev/token {"email": ...} returns a bearer token. ENV must be local.
AUTH_MODE=mock
