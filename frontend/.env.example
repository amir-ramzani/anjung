# Local development against `docker compose up` (mock auth): nothing needs to be set.
# Real environment:
# VITE_AUTH_MODE=cognito
# VITE_COGNITO_POOL_ID=<the user pool id from the Auth stack output, e.g. ap-southeast-5_AbCdEf123>
# VITE_COGNITO_CLIENT_ID=<the spa client id from the Auth stack output>
# VITE_API_BASE_URL=https://api.dev.anjung.my
# VITE_WHATSAPP_SENDING=true   # only once the WhatsApp integration (D3) is live: shows "Send by WhatsApp"
